{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@navigation/*": ["src/navigation/*"],
      "@screens/*":    ["src/screens/*"],
      "@store/*":      ["src/store/*"],
      "@theme/*":      ["src/theme/*"],
      "@types/*":      ["src/types/*"],
      "@utils/*":      ["src/utils/*"],
      "@api/*":        ["src/api/*"]
    }
  }
}